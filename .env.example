# Copy to .env and fill in. See PLAN.md → Prerequisites for how to obtain each value.

# --- Postgres ---
POSTGRES_PASSWORD=change-me

# --- Discord ---
# discord.com/developers/applications → New Application → Bot → Reset Token.
# Under OAuth2 → URL Generator, check the "bot" and "applications.commands"
# scopes and the "Send Messages"/"Embed Links" permissions to generate an
# invite link, then use it to add the bot to your server.
DISCORD_BOT_TOKEN=
# Right-click your server icon → Copy Server ID (Developer Mode must be on
# first). Slash commands (/trip, /track) register to this one server only,
# so they appear instantly instead of waiting up to an hour for Discord's
# global-command propagation.
DISCORD_GUILD_ID=

# --- Travelpayouts ---
# travelpayouts.com → Profile → API token
TRAVELPAYOUTS_TOKEN=

# --- AI (optional) ---
# aistudio.google.com → Get API key. Leave blank to disable AI features —
# the digest falls back to plain templates automatically.
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash if left blank.
GEMINI_MODEL=
# Local Ollama server (e.g. http://ollama:11434) used as a fallback when
# Gemini is unset or fails. Leave blank to skip the fallback entirely.
OLLAMA_URL=
# Defaults to llama3.2 if left blank.
OLLAMA_MODEL=

# --- Admin auth ---
# bcrypt hash of your chosen admin password, e.g.:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
#
# IMPORTANT: Docker Compose re-interprets $ inside .env values when it
# substitutes them into docker-compose.yml's ${ADMIN_PASSWORD_HASH} — a
# bcrypt hash like $2a$10$abc... will silently get mangled (each $X
# treated as a reference to a variable named X, usually blank) unless
# every literal $ is doubled to $$. The hash below is a real, working
# example — note every $ is doubled — for the password "secret". Don't
# actually use this one; generate your own with the htpasswd command above.
#   ADMIN_PASSWORD_HASH=$$2a$$10$$MWKEpoNepZdus2R1aJxKtO1Iqx79Uqt6sbiyd/0DTGs8b6OgUw49e
ADMIN_PASSWORD_HASH=
# random 32+ byte secret for signing session cookies, e.g.: openssl rand -hex 32
SESSION_SECRET=

# --- Deployment ---
# A real domain (with its DNS A/AAAA record already pointing at this VM's
# IP) gets Caddy an automatic Let's Encrypt certificate — ports 80 and 443
# must be reachable from the internet for that to succeed. Leave as
# "localhost" for local `docker compose up`, which Caddy serves over
# plain HTTP with no certificate.
APP_DOMAIN=localhost
LOG_LEVEL=info
# How many days of nightly pg_dump backups to keep (scripts/backup.sh).
BACKUP_RETENTION_DAYS=14
