{
    "swagger": "2.0",
    "info": {
        "description": "Backend for the Pricewatch admin panel — watches, price history, run logs, settings, and Discord channel status. Single-admin: every route except /auth/login and /meta requires a valid session.\nVersioned by URL prefix (/api/v1/...) — see internal/httpapi/handlers.APIVersion and internal/httpapi/router.go.",
        "title": "Pricewatch API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/analytics/summary": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Total/enabled/stale watch counts plus the average 7-day price delta across watches with enough history. Scoped to what's actually computable today — no figure is reported for a feature that doesn't exist yet (e.g. threshold alerts).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analytics"
                ],
                "summary": "Dashboard KPI summary",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_SamPariat_pricewatch_internal_httpapi_presenter_v1.AnalyticsSummary"
                        }
                    },
                    "500": {
                        "description": "list watches",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "The only unauthenticated /api route besides /meta and the health checks. Compares against a bcrypt hash rather than a plain password (PLAN.md Prerequisites — ADMIN_PASSWORD_HASH), and always takes the same code path on failure so it doesn't distinguish \"wrong password\" from any other rejection at the network-timing level. On success, sets an httpOnly session cookie — see internal/httpapi/doc.go's CookieAuth security definition.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log in",
                "parameters": [
                    {
                        "description": "Admin password",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_httpapi_handlers.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "no content — session cookie set"
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid password",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "description": "Clears the session cookie. Not itself session-protected — logging out never requires already being logged in.",
                "tags": [
                    "auth"
                ],
                "summary": "Log out",
                "responses": {
                    "204": {
                        "description": "no content"
                    }
                }
            }
        },
        "/channel/status": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Backs the panel's \"Discord connected\" indicator — checks whether the Gateway connection is authenticated via the Notifier port, so a revoked or wrong bot token shows up immediately rather than only being discovered when a digest silently fails to send.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "channel"
                ],
                "summary": "Notifier channel status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_httpapi_handlers.channelStatusResponse"
                        }
                    },
                    "502": {
                        "description": "check channel status",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/meta": {
            "get": {
                "description": "Unauthenticated — the one route (besides /auth/login) a client needs to work before it has a session.",
